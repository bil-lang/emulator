{
  "transport": "message-channel",
  "leaves": [
    {
      "match": {
        "row": "*",
        "col": "0"
      },
      "proc": "origin",
      "binds": {
        "eastIn": "1",
        "eastOut": "1"
      }
    },
    {
      "match": {
        "row": "*",
        "col": "cols-1"
      },
      "proc": "reflect",
      "binds": {
        "westIn": "3",
        "westOut": "3"
      }
    },
    {
      "match": {
        "default": true
      },
      "proc": "relay",
      "binds": {
        "eastIn": "1",
        "eastOut": "1",
        "westIn": "3",
        "westOut": "3"
      }
    }
  ]
}