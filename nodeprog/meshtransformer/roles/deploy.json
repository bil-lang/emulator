{
  "transport": "message-channel",
  "leaves": [
    {
      "match": {
        "row": "0",
        "col": "0"
      },
      "proc": "controller",
      "binds": {
        "fromEast": "1",
        "toEast": "1"
      }
    },
    {
      "match": {
        "row": "0",
        "col": "cols-1"
      },
      "proc": "rowEnd",
      "binds": {
        "fromWest": "3",
        "toWest": "3"
      }
    },
    {
      "match": {
        "row": "0",
        "col": "*"
      },
      "proc": "relay",
      "binds": {
        "fromEast": "1",
        "fromWest": "3",
        "toEast": "1",
        "toWest": "3"
      }
    },
    {
      "match": {
        "default": true
      },
      "proc": "idle"
    }
  ]
}